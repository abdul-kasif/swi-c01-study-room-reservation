# Ignore local SQLite databases, journals, and temporary locks
*.db
*.sqlite3
*.sqlite
*.db-journal
*.db-wal
*.db-shm

# Ignore local environment configuration files (secrets, keys, tokens)
.env
.env.*
!.env.example

# Ignore application logs
*.log
logs/

# ==========================================
# Python Artifacts & Cache
# ==========================================
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Standard venv/virtualenv target folders
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Poetry, Pipenv, and Conda artifacts
.poetry/
.pipenv/
.anaconda/
.conda/

# Pytest and coverage
.pytest_cache/
.htmlcov/
htmlcov/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.mutmut-cache

# Code linters and formatters
.mypy_cache/
.ruff_cache/
.black
.pyre/

# VS Code
.vscode/
